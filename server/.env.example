# ========== 赛博表情包制造局 环境配置 ==========
# 复制此文件为 .env 并填写真实配置

# 服务端口
PORT=3001

# AI 服务提供商：
#   mock      本地模拟（不调用真实 API）
#   dashscope 通义万相图像生成（推荐，最简单）
#   aliyun    阿里云人脸融合（流程较复杂）
AI_PROVIDER=mock

# ========== 通义万相（百炼 DashScope）配置 ==========
# 获取 API Key：https://bailian.console.aliyun.com/?tab=model#/api-key
# 开通模型：在百炼平台开通 wan2.6-image 模型
# 只需一个 API Key 即可，无需 OSS、无需模板注册
DASHSCOPE_API_KEY=
# 模型名称（一般无需修改）
DASHSCOPE_MODEL=wan2.6-image
# API 端点（一般无需修改）
DASHSCOPE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# ========== 阿里云视觉智能开放平台配置（provider=aliyun 时使用）==========
# 获取方式：https://help.aliyun.com/zh/viapi/getting-started/create-the-accesskey
# 开通服务：https://vision.aliyun.com/facebody
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 人脸人体服务 endpoint（默认上海地域，一般无需修改）
ALIYUN_ENDPOINT=facebody.cn-shanghai.aliyuncs.com
