# ========== 赛博表情包制造局 环境配置 ==========
# 复制此文件为 .env 并填写真实配置

# 服务端口
PORT=3001

# AI 服务提供商：
#   mock      本地模拟（不调用真实 API）
#   doubao    豆包 Seedream（推荐，火山引擎 Ark，换脸效果好）
#   dashscope 通义万相图像生成
#   aliyun    阿里云人脸融合（流程较复杂）
AI_PROVIDER=mock

# ========== 豆包 Seedream（火山引擎 Ark）配置 ==========
# 获取 API Key：https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
# 开通模型：在火山方舟控制台开通 doubao-seedream 模型
# 只需一个 API Key 即可，支持多图 Base64 输入，无需 OSS
DOUBAO_API_KEY=
# 模型 ID（在火山方舟控制台-模型广场查看，不同版本 ID 不同）
DOUBAO_MODEL=doubao-seedream-4-0-250828
# API 端点（一般无需修改）
DOUBAO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations

# ========== 通义万相（百炼 DashScope）配置 ==========
# 获取 API Key：https://bailian.console.aliyun.com/?tab=model#/api-key
# 开通模型：在百炼平台开通 wan2.6-image 模型
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=wan2.6-image
DASHSCOPE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# ========== 阿里云视觉智能开放平台配置（provider=aliyun 时使用）==========
# 获取方式：https://help.aliyun.com/zh/viapi/getting-started/create-the-accesskey
# 开通服务：https://vision.aliyun.com/facebody
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 人脸人体服务 endpoint（默认上海地域，一般无需修改）
ALIYUN_ENDPOINT=facebody.cn-shanghai.aliyuncs.com
